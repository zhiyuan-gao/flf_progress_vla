# Copy this file to .env and replace every path for the local machine.
GR00T_ROOT=/absolute/path/to/Isaac-GR00T
ROBOCASA365_DATA_ROOT=/absolute/path/to/robocasa365/v1.0/target/composite
GR00T_BASE_CHECKPOINT=/absolute/path/to/checkpoint-60000

# Used only by scripts/launch_two_gpu.sh. Plain `python` is also valid when the
# desired environment is already activated.
STAGE_STATE_PYTHON=/absolute/path/to/gr00t-environment/bin/python
NPROC_PER_NODE=2
CUDA_VISIBLE_DEVICES=0,1
