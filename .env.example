# Copy this file to .env and replace every path for the local machine.
GR00T_ROOT=/absolute/path/to/Isaac-GR00T
ROBOCASA365_DATA_ROOT=/absolute/path/to/robocasa365/v1.0/target/composite
GR00T_BASE_CHECKPOINT=/absolute/path/to/checkpoint-60000

# Used by all launchers. Plain `python` is also valid when the desired
# environment is already activated.
STAGE_STATE_PYTHON=/absolute/path/to/gr00t-environment/bin/python

# NPROC_PER_NODE is used by the original v1 launcher. The semantic launchers
# use a fixed world size of 2 (A40 development) or 4 (A100 formal training).
NPROC_PER_NODE=2

# All launchers source .env. Use 0,1 for a two-GPU A40/H200 run and change
# this to 0,1,2,3 before running the four-A100 semantic launcher.
CUDA_VISIBLE_DEVICES=0,1
